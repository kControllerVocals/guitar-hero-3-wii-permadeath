script GetCurrentLevel 
	return level = ($current_level)
endscript

script get_level_prefix 
	if StructureContains \{Structure = $LevelZones
			$current_level}
		return prefix = ($LevelZones.($current_level).name) prefix_crc = ($LevelZones.($current_level).zone)
	endif





	return \{prefix = 'z_unknown'
		prefix_crc = z_unknown}
endscript

script preqbromid 
	pausegh3
endscript

script postqbromid 
	restart_gem_scroller song_name = ($current_song) difficulty = ($current_difficulty) difficulty2 = ($current_difficulty2) StartTime = ($current_starttime) device_num = ($player1_status.controller)
endscript

script InFrontend 
	return \{false}
endscript

script startrendering 
	StartRendering_C
	change \{pause_no_render = 0}
endscript

script stoprendering 
	StopRendering_C
	change \{pause_no_render = 1}
endscript

script PlayAnimatedTexture 
	spawnscriptnow AnimatedTextureLoop params = {<...>}
endscript

script AnimatedTextureLoop \{u = -1
		v = -1
		framerate = 10
		grid_size_x = 8
		grid_size_y = 8
		count = -1
		ShowStats = 0
		start_x = 0
		start_y = 0}
	AnimatedTextureLoop_CFunc_Setup
	begin
	if AnimatedTextureLoop_CFunc
		break
	endif
	repeat
	AnimatedTextureLoop_CFunc_Cleanup
endscript

script SetAnimatingTextureState \{state = -1}
	ExtendCRC <object> '_AnimTexture_State' out = state_flag
	if (<state> = -1)
		if GetNodeFlag (<state_flag>)
			ChangeNodeFlag (<state_flag>) 0
		else
			ChangeNodeFlag (<state_flag>) 1
		endif
	else
		ChangeNodeFlag (<state_flag>) (<state>)
	endif
endscript
g_movie_setup_count = 0

script pre_movie_cleanup 
	change g_movie_setup_count = ($g_movie_setup_count + 1)

	if ($g_movie_setup_count > 1)
		return
	endif
	if NOT ((isps2) || (IsNgc))
		return
	endif

	unload_songqpak
	GetHeapSize \{heap_song}
	heap_size_song = <size>
	memdeleteheap \{name = 'heap_song'}

	GetPakManCurrent \{map = zones}
	zones_pak = <pak>
	SetPakManCurrentBlock \{map = zones
		pak = none
		block_scripts = 1}
	DestroyPakManMap \{map = zones}
	GetHeapSize \{heap_zones}
	heap_size_zones = <size>
	memdeleteheap \{name = 'heap_zones'}

	UnloadPak \{'pak/oogame/oogame.pak'}
	GetPakManCurrent \{map = flow_state_pak_map}
	flow_state_pak = <pak>
	shut_down_flow_manager
	SetPakManCurrentBlock \{map = flow_state_pak_map
		pak = none
		block_scripts = 1}
	DestroyPakManMap \{map = flow_state_pak_map}
	guitar_hud_pak = 0
	if ExistsPakManMap \{map = guitar_hud}
		GetPakManCurrent \{map = guitar_hud}
		guitar_hud_pak = <pak>
		SetPakManCurrentBlock \{map = guitar_hud
			pak = none
			block_scripts = 1}
		DestroyPakManMap \{map = guitar_hud}
	endif
	GetHeapSize \{heap_game}
	heap_size_game = <size>
	memdeleteheap \{name = 'heap_game'}
	if (<guitar_hud_pak> = 0)
		return reset_state = {
			flow_state_pak = <flow_state_pak>
			zones_pak = <zones_pak>
			heap_size_song = <heap_size_song>
			heap_size_zones = <heap_size_zones>
			heap_size_game = <heap_size_game>
			heap_size_lightshow = <heap_size_lightshow>
			ui_flow_manager_state = ($ui_flow_manager_state [0])
		}
	else
		return reset_state = {
			guitar_hud_pak = <guitar_hud_pak>
			flow_state_pak = <flow_state_pak>
			zones_pak = <zones_pak>
			heap_size_song = <heap_size_song>
			heap_size_zones = <heap_size_zones>
			heap_size_game = <heap_size_game>
			heap_size_lightshow = <heap_size_lightshow>
			ui_flow_manager_state = ($ui_flow_manager_state [0])
		}
	endif
endscript

script post_movie_reset 
	change g_movie_setup_count = ($g_movie_setup_count - 1)

	if ($g_movie_setup_count > 0)
		return
	endif
	if NOT ((isps2) || (IsNgc))
		return
	endif
	PushMemProfile \{'Game Heap'}
	MemInitHeap name = 'heap_game' size = (<reset_state>.heap_size_game) vram_size = 0
	PopMemProfile
	if StructureContains Structure = <reset_state> guitar_hud_pak
		CreatePakManMap \{map = guitar_hud
			folder = 'pak/guitar_hud/'
			links = guitar_hud_links
			uselinkslots
			heap = heap_game}
		SetPakManCurrentBlock map = guitar_hud pak = (<reset_state>.guitar_hud_pak) block_scripts = 1
	endif

	if IsNgc
		CreatePakManMap \{map = flow_state_pak_map
			folder = 'pak/flow_state/'
			links = flow_state_pak_links_ngc
			uselinkslots
			heap = heap_game}
	else
		CreatePakManMap \{map = flow_state_pak_map
			folder = 'pak/flow_state/'
			links = flow_state_pak_links_ps2
			uselinkslots
			heap = heap_game}
	endif
	if ((<reset_state>.ui_flow_manager_state = career_beat_game_fs) || (<reset_state>.ui_flow_manager_state = coop_career_beat_game_fs))
		SetPakManCurrentBlock map = flow_state_pak_map pak = (<reset_state>.flow_state_pak) block_scripts = 1
	elseif ((<reset_state>.ui_flow_manager_state = bootup_sequence_fs) || (<reset_state>.ui_flow_manager_state = career_select_venue_fs) || (<reset_state>.ui_flow_manager_state = coop_career_select_venue_fs))
		SetPakManCurrentBlock map = flow_state_pak_map pak = (<reset_state>.flow_state_pak) block_scripts = 1
	else
		start_flow_manager flow_state = (<reset_state>.ui_flow_manager_state)
	endif
	PushMemProfile \{'Characters'}

	MemInitHeap name = 'heap_zones' size = (<reset_state>.heap_size_zones) vram_size = <heap_size_zones_vram>
	CreatePakManMap \{map = zones
		links = GH3Zones
		folder = 'zones/'
		uselinkslots
		heap = heap_zones}
	ResetWaypoints
	SetPakManCurrentBlock map = zones pak = (<reset_state>.zones_pak) block_scripts = 1

	MemInitHeap name = 'heap_song' size = (<reset_state>.heap_size_song) vram_size = <heap_size_song_vram>
	PopMemProfile
endscript

script reload_venue \{force_encore = 0}
	spawnscriptnow convoluted_because_of_wait_blocking_reload_venue params = {force_encore = <force_encore>}
endscript

script convoluted_because_of_wait_blocking_reload_venue 
	shut_down_flow_manager
	PauseGame
	kill_gem_scroller
	start_song force_venue_reload = 1 force_encore = <force_encore>
endscript
